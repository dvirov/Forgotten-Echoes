						},
						{
							"channel": "function",
							"data_points": [
								{
									"function": "# LAST FRAME\n\n# Set entity's health to 0, instantly killing it due to {DeathTime:99s}\nfunction ceapi:global/commands/as_entity/1 {cmd:'data merge entity @s {Health:0f}'}\n# Remove the animated java model\nfunction aj:echo_knight/remove/this\nloot spawn ~ ~ ~ loot forgotten_echoes:gameplay/echo_knight_defeat\nadvancement grant @a[distance=..20] only forgotten_echoes:echo_knight_defeat\n",
									"execute_condition": "",
									"repeat": false,
									"repeat_frequency": 1
								}
							],
