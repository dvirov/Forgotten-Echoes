						{
							"channel": "function",
							"data_points": [
								{
									"function": "# FRAME 0\n\n# Hide bossbar from any nearby players\nfunction ceapi:global/commands/as_entity/1 {cmd:'tag @s add bossbar.hide'}\n# Make entity invulnerable and NoAI\nfunction ceapi:global/commands/as_entity/1 {cmd:'data merge entity @s {Invulnerable:1b,NoAI:true}'}\n# End boss music\nfunction ceapi:global/commands/as_entity/1 {cmd:'function ceapi:global/music/end'}",
									"execute_condition": "",
									"repeat": false,
									"repeat_frequency": 1
								}
							],
							"uuid": "317c1a40-d215-f290-6506-b853590f2b60",
							"time": 0,
